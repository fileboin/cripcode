{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cripcode",
  "version": "0.18.7",
  "identifier": "com.fileboin.cripcode",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/CripCode/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "fonts/*": "fonts/",
      "resources/scrcpy-server.jar": "scrcpy-server.jar",
      "resources/templates/*.zip": "templates/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fileboin/cripcode/releases/latest/download/latest-{{target}}.json",
        "https://github.com/fileboin/cripcode/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQkEyREI2MjZGNDUxNEIKUldSTFVmUW10aTI2Z01NOXhhN2lRVkYvdU1zVDhqTFpESnNTQUxkR2NaUGRQYmk4QUNhYjRTbnMK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cripcode"
        ]
      }
    }
  }
}
